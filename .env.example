# Environment Configuration
ENVIRONMENT=dev  # dev or prod

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o  # or gpt-4, gpt-3.5-turbo, etc.

# Database Configuration
# For development (SQLite is used automatically if not specified)
# DATABASE_URL=sqlite+aiosqlite:///./agent_system.db

# For production (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agentdb

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info  # debug, info, warning, error

# Agent Configuration
MAX_REFLECTION_ITERATIONS=2

# Optional: LangSmith Tracing (for debugging and monitoring)
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=langgraph-multi-agent

# Optional: Anthropic (if using Claude models)
# ANTHROPIC_API_KEY=your-anthropic-api-key
